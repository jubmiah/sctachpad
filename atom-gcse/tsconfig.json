{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Expo's base config sets customConditions: ["react-native"], which stops the
    // `node:` built-in modules used by the domain tests from resolving. Naming the
    // type packages explicitly pulls them in as globals instead.
    "types": ["node", "react"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
